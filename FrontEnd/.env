GENERATE_SOURCEMAP=false

# Chỉ dùng cho local dev (npm start). Khi chạy Docker,
# REACT_APP_API_BASE_URL được inject qua build args từ file .env ở root.
# REACT_APP_API_BASE_URL=https://newbackend-75rw.onrender.com
REACT_APP_API_BASE_URL=http://localhost:9090

# Tài khoản admin mặc định được cấu hình tập trung ở ../.env (root),
# không đặt credentials trong thư mục frontend.
