# ------------------------------------------------------------
# .env rieng cho FRONTEND (CRA) - chi dung khi chay `npm start`.
# CRA CHI doc .env trong thu muc nay; file .env o root KHONG
# duoc CRA doc (no phuc vu docker-compose).
# Khong chua secret -> duoc commit.
# ------------------------------------------------------------

# Tat sourcemap de build nhanh hon
GENERATE_SOURCEMAP=false

# Dia chi backend khi dev local (nhung vao bundle luc build).
# Khi chay Docker: duoc inject qua build arg tu root .env.
# REACT_APP_API_BASE_URL=https://newbackend-75rw.onrender.com   # deploy
REACT_APP_API_BASE_URL=http://localhost:9090
