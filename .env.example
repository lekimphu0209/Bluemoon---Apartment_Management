# ============================================================
# BLUEMOON - Mẫu cấu hình môi trường
# Copy file này thành .env rồi điền giá trị thật: cp .env.example .env
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=bluemoon_db
MYSQL_PORT=3306

# ---------- Backend ----------
BACKEND_PORT=9090
DB_URL=jdbc:mysql://mysql:3306/bluemoon_db?sslmode=require
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT - sinh secret mới: openssl rand -base64 44
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=3600000

# ---------- Tài khoản admin mặc định ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@gmail.com
ADMIN_PHONE=0123456789

# ---------- Frontend ----------
REACT_APP_API_BASE_URL=http://localhost:9090
FRONTEND_PORT=80
