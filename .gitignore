# ---------- Backend (Spring Boot / Maven) ----------
Backend/target/
Backend/.mvn/wrapper/maven-wrapper.jar
Backend/HELP.md
!**/src/main/**/target/
!**/src/test/**/target/

# ---------- Frontend (React / CRA) ----------
FrontEnd/node_modules/
FrontEnd/build/
FrontEnd/coverage/
FrontEnd/.eslintcache
FrontEnd/.env.local
FrontEnd/.env.development.local
FrontEnd/.env.test.local
FrontEnd/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# ---------- Docker / MySQL ----------
mysql/data/

# ---------- Secrets (KHÔNG commit) ----------
# Chi khoa .env o root (mat khau DB / JWT / admin). Mau: .env.example
# FrontEnd/.env KHONG chua secret (chi API URL) nen van duoc commit.
/.env

