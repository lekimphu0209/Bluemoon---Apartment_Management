# Chuan hoa line-ending cho toan bo repo (Backend + FrontEnd)
* text=auto

# Script shell phai giu LF de chay duoc tren Linux/Docker
*.sh text eol=lf
mvnw text eol=lf

# Script Windows giu CRLF
*.cmd text eol=crlf
